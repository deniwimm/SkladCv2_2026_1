<Window x:Class="SkladCv2_2026.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SkladCv2_2026"
        xmlns:vm="clr-namespace:SkladCv2_2026.ViewModels"
        mc:Ignorable="d"
        Title="SKLADOVÝ SYSTÉM"
        Height="680"
        Width="600"
        WindowStartupLocation="CenterScreen">

  

    <Window.Resources>
        <Style x:Key="MenuTileButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="130" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="/Images/Logo.png"
               MaxHeight="110"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Margin="0,0,0,10" />

        <TextBlock Grid.Row="1"
                   Text="Skladový systém"
                   FontSize="36"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#3D8FE6"
                    BorderThickness="2"
                    Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3D8FE6" Padding="10,6">
                        <TextBlock Text="TABULKY" Foreground="White" FontWeight="Bold" FontSize="14" />
                    </Border>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="5">
                        <Button Style="{StaticResource MenuTileButtonStyle}"
                                Command="{Binding OpenMaterialCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Images/MainMenu/material.png" Width="52" Height="52" Margin="0,0,0,8" />
                                <TextBlock Text="Materiál" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuTileButtonStyle}"
                                Command="{Binding OpenPaletyCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Images/MainMenu/paleta.png" Width="52" Height="52" Margin="0,0,0,8" />
                                <TextBlock Text="Palety" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="#3D8FE6"
                    BorderThickness="2"
                    Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#3D8FE6" Padding="10,6">
                        <TextBlock Text="PŘEHLEDY" Foreground="White" FontWeight="Bold" FontSize="14" />
                    </Border>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="5">
                        <Button Style="{StaticResource MenuTileButtonStyle}"
                                Command="{Binding OpenPrehledMaterialuCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Images/MainMenu/prehledmat.png" Width="52" Height="52" Margin="0,0,0,8" />
                                <TextBlock Text="Přehled materiálu" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource MenuTileButtonStyle}"
                                Command="{Binding OpenPrehledPaletCommand}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image Source="/Images/MainMenu/prehledpal.png" Width="52" Height="52" Margin="0,0,0,8" />
                                <TextBlock Text="Přehled palet" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="5,15,5,5" LastChildFill="False">
            <CheckBox Content="Povolit tabulky"
                      IsChecked="{Binding PovolitTabulky}"
                      VerticalAlignment="Center"
                      DockPanel.Dock="Left"
                      FontSize="14" />

            <TextBlock Text="(c) 2025 TUCNAK"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"
                       Foreground="#333333"
                       FontSize="13" />
        </DockPanel>
    </Grid>
</Window>